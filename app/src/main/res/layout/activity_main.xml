<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <EditText android:id="@+id/nameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Your name" android:inputType="textPersonName" />
    <Button android:id="@+id/greetButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Greet" />
    <TextView android:id="@+id/resultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hello, Android!" android:textSize="22sp" />
</LinearLayout>
